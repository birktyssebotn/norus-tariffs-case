install.packages("patchwork")
library(readxl)
library(tidyverse)
read_ssb_export <- function(path) {
raw <- read_excel(path, skip = 3)
raw %>%
rename(industry = 1, country = 2) %>%
# The only thing every real SITC 1-digit row has in common, and
# nothing else (footnotes, the "Exports" label row, "- TOTAL") does,
# is that its label starts with a single digit 0-9 followed by a space.
filter(str_detect(industry, "^[0-9] ")) %>%
select(-country) %>%
pivot_longer(cols = -industry, names_to = "month_raw", values_to = "exports_nok_1000") %>%
mutate(
exports_nok_1000 = as.numeric(exports_nok_1000),
date = ym(str_replace(month_raw, "M", "-")),
exports_mill_nok = exports_nok_1000 / 1000
) %>%
filter(!is.na(date), !is.na(exports_mill_nok)) %>%
select(industry, date, exports_mill_nok)
}
source("scripts/00_helpers.R")
data_exports <- read_ssb_export("data/raw/exports_us_monthly.xlsx")
dir.create("data/processed", showWarnings = FALSE, recursive = TRUE)
write_csv(data_exports, "data/processed/exports_us_tidy.csv")
message("Wrote ", nrow(data_exports), " rows to data/processed/exports_us_tidy.csv")
source("scripts/00_helpers.R")
exports_us <- read_csv("data/processed/exports_us_tidy.csv", show_col_types = FALSE) %>%
rename(exports_us_mill_nok = exports_mill_nok)
exports_total <- read_ssb_export("data/raw/exports_total_monthly.xlsx") %>%
rename(exports_total_mill_nok = exports_mill_nok)
# Inner join: keep only industry-months present in both files. If the two
# downloads don't cover the exact same months, this will silently drop the
# mismatched ones -- check nrow() below against what you expect
# (10 industries x N shared months) to catch that.
share_of_total <- exports_us %>%
inner_join(exports_total, by = c("industry", "date")) %>%
mutate(share_of_total = exports_us_mill_nok / exports_total_mill_nok)
dir.create("data/processed", showWarnings = FALSE, recursive = TRUE)
write_csv(share_of_total, "data/processed/exports_us_share_of_total.csv")
message("Wrote ", nrow(share_of_total), " rows to data/processed/exports_us_share_of_total.csv")
source("scripts/00_helpers.R")
raw_long <- read_ssb_export("data/raw/exports_us_monthly_long.xlsx")
industries <- raw_long %>%
distinct(industry) %>%
filter(!str_detect(industry, "^9 ")) %>%
pull(industry)
decompose_one_industry <- function(df) {
df <- df %>% arrange(date)
n_expected <- interval(min(df$date), max(df$date)) %/% months(1) + 1
if (nrow(df) != n_expected) {
warning("Gap detected in series for ", unique(df$industry), " -- skipping STL for this industry.")
return(NULL)
}
ts_log <- ts(
log(df$exports_mill_nok),
start = c(year(min(df$date)), month(min(df$date))),
frequency = 12
)
fit <- stl(ts_log, s.window = "periodic")
comp <- as_tibble(fit$time.series)
df %>%
mutate(
trend = comp$trend,
seasonal = comp$seasonal,
remainder = comp$remainder,
expected_mill_nok = exp(trend + seasonal),
remainder_sd = sd(remainder),
out_of_normal_range = abs(remainder) > 2 * remainder_sd
)
}
seasonal_data <- raw_long %>%
filter(industry %in% industries) %>%
group_by(industry) %>%
group_split() %>%
map(decompose_one_industry) %>%
bind_rows()
dir.create("data/processed", showWarnings = FALSE, recursive = TRUE)
write_csv(seasonal_data, "data/processed/exports_us_seasonal.csv")
message("Wrote ", nrow(seasonal_data), " rows to data/processed/exports_us_seasonal.csv")
message("Industries excluded from seasonal analysis: 9 Other commodities and transactions (too sparse/irregular)")
library(readxl)
library(tidyverse)
# Parses one SSB Table 08806 export. Row 4 (month labels) becomes the
# header; row 5 ("Exports", repeated) and footnote/contact rows below the
# data get dropped by the industry filter, since only real SITC 1-digit
# rows start with a digit followed by a space.
read_ssb_export <- function(path) {
raw <- read_excel(path, skip = 3)
raw %>%
rename(industry = 1, country = 2) %>%
filter(str_detect(industry, "^[0-9] ")) %>%
select(-country) %>%
pivot_longer(cols = -industry, names_to = "month_raw", values_to = "exports_nok_1000") %>%
mutate(
exports_nok_1000 = as.numeric(exports_nok_1000),
date = ym(str_replace(month_raw, "M", "-")),
exports_mill_nok = exports_nok_1000 / 1000
) %>%
filter(!is.na(date), !is.na(exports_mill_nok)) %>%
select(industry, date, exports_mill_nok)
}
